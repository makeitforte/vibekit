      <mxGeometry x="820" y="285" width="200" height="50" as="geometry" />
    </mxCell>

    <!-- Show banner -->
    <mxCell id="banner" value="Show &#34;Run Cascade&#34; banner&#xa;(amber = below threshold, red = negative)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="390" y="390" width="380" height="55" as="geometry" />
    </mxCell>

    <!-- User clicks -->
