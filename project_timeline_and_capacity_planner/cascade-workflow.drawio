      <mxGeometry x="440" y="485" width="280" height="45" as="geometry" />
    </mxCell>

    <!-- ── PHASE 2: ALGORITHM ── -->
    <mxCell id="p2_label" value="PHASE 2 — ALGORITHM (one full pass, all weeks)" style="text;html=1;strokeColor=none;fillColor=#fff3e0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;arcSize=10;fontSize=11;fontStyle=1;fontColor=#876200;" vertex="1" parent="1">
      <mxGeometry x="60" y="560" width="340" height="30" as="geometry" />
    </mxCell>

    <!-- Loop weeks -->
    <mxCell id="loop_week" value="For each Week W&#xa;(chronological order W1→W2→W3…)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="390" y="560" width="380" height="55" as="geometry" />
    </mxCell>

    <!-- Loop roles -->
