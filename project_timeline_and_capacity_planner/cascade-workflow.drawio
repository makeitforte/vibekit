      <mxGeometry x="60" y="945" width="240" height="30" as="geometry" />
    </mxCell>

    <!-- Walk tasks -->
    <mxCell id="walk" value="Walk tasks TOP → BOTTOM (priority order)&#xa;Track cumulative effort, overflow_found = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#e1a0b0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
