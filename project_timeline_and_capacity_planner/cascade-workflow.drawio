      <mxGeometry x="390" y="650" width="380" height="55" as="geometry" />
    </mxCell>

    <!-- Compute available -->
    <mxCell id="avail" value="Available(W,R) = Capacity − Taken − Holiday&#xa;(does NOT subtract threshold — target is buffer ≥ 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="345" y="740" width="470" height="55" as="geometry" />
    </mxCell>

    <!-- Decision: need cascade? -->
