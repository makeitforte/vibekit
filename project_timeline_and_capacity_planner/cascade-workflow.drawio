    </mxCell>

    <!-- YES — push all -->
    <mxCell id="push_all" value="Push ALL effort(T,R,W) to W+1&#xa;effort(T,R,W) = 0&#xa;effort(T,R,W+1) += effort(T,R,W)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="820" y="1118" width="240" height="65" as="geometry" />
    </mxCell>

    <!-- NO — accumulate -->
    <mxCell id="accum" value="cumulative += effort(T,R,W)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="370" y="1225" width="420" height="45" as="geometry" />
    </mxCell>

    <!-- Decision: cumulative > available? -->
    <mxCell id="d_cum" value="cumulative &gt; Available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="400" y="1305" width="360" height="70" as="geometry" />
    </mxCell>

    <!-- NO — task fits -->
    <mxCell id="fits" value="Task fits → continue&#xa;to next task ↺" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="820" y="1318" width="160" height="50" as="geometry" />
    </mxCell>

    <!-- YES — OVERFLOW POINT -->
    <mxCell id="overflow" value="⚡ OVERFLOW POINT at Task T&#xa;keep = Available − (cumulative − effort(T))&#xa;push = effort(T) − keep&#xa;effort(T,R,W) = keep&#xa;effort(T,R,W+1) += push&#xa;overflow_found = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="355" y="1415" width="450" height="100" as="geometry" />
