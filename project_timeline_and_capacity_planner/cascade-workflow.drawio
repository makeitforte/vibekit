      <mxGeometry x="420" y="80" width="320" height="55" as="geometry" />
    </mxCell>

    <!-- Compute buffer -->
    <mxCell id="compute" value="Compute Buffer for every Week × Role&#xa;Buffer = Capacity − Total Required − Taken − Holiday" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="370" y="175" width="420" height="55" as="geometry" />
    </mxCell>

    <!-- Decision: any below threshold? -->
    <mxCell id="d_trigger" value="Any Week+Role where&#xa;Buffer &lt; Min Buffer Threshold?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="390" y="270" width="380" height="80" as="geometry" />
    </mxCell>

    <!-- No — nothing to do -->
